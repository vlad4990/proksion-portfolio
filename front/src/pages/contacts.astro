---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contacts, contactsIntro } from '@/data/contacts';
---

<BaseLayout title="PROKSION · контакты" description="Контакты Кристины — Telegram, Email, Behance.">
  <main id="content" class="contacts">
    <h1 class="contacts__title">КОНТАКТЫ</h1>

    <p class="contacts__intro">{contactsIntro}</p>

    <ul class="contacts__list">
      {contacts.map((c) => {
        const external = c.href.startsWith('http');
        return (
          <li class="contacts__item">
            <a
              href={c.href}
              class="contacts__link"
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              <span class="contacts__label">{c.label}</span>
              <span class="contacts__hint">{c.hint}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </main>
</BaseLayout>

<style>
  .contacts {
    max-width: var(--page-w);
    margin: 0 auto;
    padding: calc(var(--sp-10) + var(--sp-7)) var(--page-pad) var(--sp-10);
  }

  .contacts__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-header-1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--fg-muted);
    line-height: 1;
    margin: 0 0 var(--sp-7);
  }

  .contacts__intro {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.4;
    color: var(--fg);
    max-width: 900px;
    margin: 0 0 var(--sp-9);
  }

  .contacts__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .contacts__item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .contacts__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-5);
    padding: var(--sp-5) 0;
    text-decoration: none;
    color: inherit;
    transition: color var(--dur-base) var(--ease-out);
  }
  .contacts__link:hover .contacts__label { color: var(--accent); }
  .contacts__link:hover .contacts__hint { color: var(--fg-strong); }

  .contacts__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-header-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--fg-muted);
    line-height: 1;
    transition: color var(--dur-base) var(--ease-out);
  }

  .contacts__hint {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-sub-section);
    color: var(--fg-strong);
    line-height: 1;
    text-align: right;
    transition: color var(--dur-base) var(--ease-out);
  }

  /* Tablet — урезаем верхний padding (нет занавеса/скролла как на /) */
  @media (max-width: 1279px) {
    .contacts {
      padding: var(--sp-9) var(--page-pad) var(--sp-9);
    }
    .contacts__intro { font-size: 18px; margin-bottom: var(--sp-8); }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .contacts {
      padding: var(--sp-7) var(--page-pad) calc(var(--mob-tabbar) + var(--sp-7));
    }
    .contacts__title { margin-bottom: var(--sp-5); }
    .contacts__intro {
      font-size: 14px;
      line-height: 1.55;
      margin-bottom: var(--sp-6);
    }
    .contacts__link {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-2);
      padding: var(--sp-4) 0;
    }
    .contacts__hint {
      text-align: left;
      font-size: var(--t-body);
    }
  }
</style>
