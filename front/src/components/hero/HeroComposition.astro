---
import { Picture } from 'astro:assets';
import portraitSrc from '@/assets/photo-hero-portrait.png';
---

<div class="hero">
  <div class="hero__panel" aria-hidden="true">
    <div class="hero__photo-mask">
      <Picture
        src={portraitSrc}
        alt=""
        widths={[640, 960, 1280, 1920]}
        sizes="(max-width: 767px) 100vw, 53vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
        class="hero__photo"
      />
    </div>
  </div>

  <span class="hero__wordmark">PROKSION</span>

  <div class="hero__lockup" aria-hidden="true">
    <div class="hero__lockup-line hero__lockup-line--port">PORT</div>
    <div class="hero__lockup-line hero__lockup-line--folio">FOLIO</div>
  </div>

  <img
    src="/assets/icon-marker-pixel.svg"
    alt=""
    class="hero__marker"
    aria-hidden="true"
    width="32"
    height="38"
  />
</div>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background: var(--bg);
    overflow: hidden;
  }

  /* === Desktop (≥1024) — две колонки ===================================== */
  .hero__panel {
    position: absolute;
    inset: 0 0 0 47%;
    background: var(--bg-panel);
    overflow: hidden;
  }

  .hero__photo-mask {
    position: absolute;
    inset: -8% -10%;
    transform: rotate(-3.6deg);
    transform-origin: center;
  }

  .hero__photo-mask :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    -webkit-mask-image: url(/assets/mask-hero.svg);
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
            mask-image: url(/assets/mask-hero.svg);
            mask-size: contain;
            mask-repeat: no-repeat;
            mask-position: center;
  }

  .hero__wordmark {
    position: absolute;
    top: var(--sp-9);
    left: var(--page-pad);
    font-family: var(--font-display);
    font-size: var(--t-hero);
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    line-height: 1;
    z-index: 2;
  }

  .hero__lockup {
    position: absolute;
    top: 22%;
    left: calc(var(--page-pad) - 0.02em);
    line-height: 0.82;
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--fg-strong);
    -webkit-text-stroke: var(--stroke-display) var(--border);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    pointer-events: none;
    z-index: 2;
  }

  .hero__lockup-line {
    font-size: var(--t-port-folio);
  }

  .hero__lockup-line--folio {
    margin-top: -0.1em;
    /* Оригинал: 380 / 360 = ~0.95 — выравниваем визуальную «лесенку» */
    font-size: calc(var(--t-port-folio) * 0.95);
  }

  .hero__marker {
    position: absolute;
    bottom: var(--sp-7);
    left: 23%;
    width: 32px;
    height: 38px;
    transform: rotate(90deg);
    animation: hero-marker-bob 1.6s ease-in-out infinite;
    z-index: 2;
  }

  @keyframes hero-marker-bob {
    0%, 100% { transform: rotate(90deg) translateX(0); }
    50%      { transform: rotate(90deg) translateX(8px); }
  }

  /* === Wide tablet (1024–1279) — две колонки, левая чуть шире ============
     Типография на этом коридоре уже tablet-набор (--t-hero: 72px,
     --t-port-folio: 260px из tokens). Чтобы wordmark не залезал
     под графитовую панель, расширяем левую колонку до 50%. */
  @media (max-width: 1279px) {
    .hero__panel { inset: 0 0 0 50%; }
    .hero__lockup { top: 24%; }
    .hero__marker { left: 18%; }
  }

  /* === Mobile / narrow tablet (≤1023) — стек ============================
     Wordmark сверху, lockup ниже, графитовая панель с портретом —
     внизу. Так композиция работает и на 1023×768, и на 360×640. */
  @media (max-width: 1023px) {
    .hero__panel {
      inset: auto 0 0 0;
      height: 48dvh;
    }

    .hero__wordmark {
      top: var(--sp-7);
      left: var(--page-pad);
    }

    .hero__lockup {
      /* wordmark занимает var(--t-hero) высоты, начинается на --sp-7 — кладём lockup ниже */
      top: calc(var(--sp-7) + var(--t-hero) + var(--sp-4));
      left: var(--page-pad);
      right: 0;
    }

    .hero__lockup-line,
    .hero__lockup-line--folio {
      font-size: var(--t-port-folio);
    }

    .hero__lockup-line--folio {
      margin-top: -0.06em;
    }

    .hero__marker {
      bottom: calc(var(--mob-safe-bottom, 0px) + var(--sp-5));
      left: 50%;
      transform: translateX(-50%) rotate(90deg);
      animation: hero-marker-bob-stack 1.6s ease-in-out infinite;
    }

    @keyframes hero-marker-bob-stack {
      0%, 100% { transform: translateX(-50%) rotate(90deg) translateY(0); }
      50%      { transform: translateX(-50%) rotate(90deg) translateY(8px); }
    }
  }

  /* === Mobile (<768) — те же стек-позиции, но --t-* токены ужаты ======== */
  @media (max-width: 767px) {
    .hero__panel { height: 48dvh; }
  }

  @media (max-width: 479px) {
    .hero__panel { height: 42dvh; }
  }

  /* === Reduced motion =================================================== */
  @media (prefers-reduced-motion: reduce) {
    .hero__marker { animation: none; }
  }
</style>
