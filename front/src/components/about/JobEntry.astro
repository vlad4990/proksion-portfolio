---
import type { JobEntry } from '@/data/experience';

interface Props {
  entry: JobEntry;
}

const { entry } = Astro.props;
---

<article class="job">
  <header class="job__head">
    <span class:list={['job__company', { 'job__company--dim': entry.dim }]}>
      {entry.company}
    </span>
    <span class="job__role">{entry.role}</span>
    <span class="job__duration">{entry.duration}</span>
  </header>
  <ul class="job__bullets">
    {entry.bullets.map((b) => <li>{b}</li>)}
  </ul>
</article>

<style>
  .job {
    margin-bottom: var(--sp-8);
  }

  .job__head {
    display: flex;
    align-items: baseline;
    gap: 0 var(--sp-6);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-header-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    line-height: 1;
    margin-bottom: var(--sp-5);
  }

  .job__company {
    color: var(--accent);
  }

  .job__company--dim {
    color: var(--accent-dim);
  }

  .job__role {
    color: var(--fg-muted);
  }

  .job__duration {
    margin-left: auto;
    color: var(--fg-muted);
  }

  .job__bullets {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--t-body);
    line-height: 1.27;
    color: var(--fg-muted);
  }

  .job__bullets li {
    margin-bottom: 6px;
  }

  /* Tablet — сжимаем head */
  @media (max-width: 1279px) {
    .job {
      margin-bottom: var(--sp-7);
    }
    .job__head {
      gap: 0 var(--sp-5);
      margin-bottom: var(--sp-4);
    }
    .job__bullets {
      line-height: 1.35;
    }
  }

  /* Mobile — структура «company + duration» в строке, role отдельной строкой */
  @media (max-width: 767px) {
    .job {
      margin-bottom: var(--sp-6);
    }

    .job__head {
      flex-wrap: wrap;
      gap: 2px 12px;
      font-size: var(--t-sub-section);
      line-height: 1.2;
      margin-bottom: 10px;
    }

    .job__company {
      order: 1;
    }

    .job__duration {
      order: 2;
      margin-left: 0;
    }

    .job__role {
      order: 3;
      width: 100%;
      font-size: 13px;
      line-height: 1.2;
    }

    .job__bullets {
      line-height: 1.5;
    }

    .job__bullets li {
      margin-bottom: 4px;
    }
  }
</style>
