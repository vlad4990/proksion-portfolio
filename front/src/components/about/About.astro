---
import { aboutIntro } from '@/data/about';
import { experience } from '@/data/experience';
import { education } from '@/data/education';
import JobEntry from './JobEntry.astro';
import EducationEntry from './EducationEntry.astro';
import MaskedPhoto from './MaskedPhoto.astro';
import photo1 from '@/assets/photo-masked-1.png';
import photo2 from '@/assets/photo-masked-2.png';
---

<section class="about">
  <aside class="about__photos" aria-hidden="true">
    <MaskedPhoto src={photo1} rotate={-3} class="about__photo about__photo--1" />
    <MaskedPhoto src={photo2} rotate={2.5} class="about__photo about__photo--2" />
  </aside>

  <div class="about__text">
    <p class="about__intro">{aboutIntro}</p>

    <h2 class="about__heading">Опыт работы</h2>
    {experience.map((entry) => <JobEntry entry={entry} />)}

    <h2 class="about__heading about__heading--education">Образование</h2>
    {education.map((entry) => <EducationEntry entry={entry} />)}
  </div>
</section>

<style>
  .about {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 600px) minmax(0, 1fr);
    gap: var(--sp-9);
    padding: calc(var(--sp-10) + var(--sp-7)) var(--page-pad) var(--sp-10);
    max-width: var(--page-w);
    margin: 0 auto;
  }

  .about__photos {
    position: relative;
    min-height: 1500px;
  }

  .about__photos :global(.about__photo) {
    position: absolute;
    width: 100%;
  }

  .about__photos :global(.about__photo--1) {
    top: 40px;
    left: -120px;
    max-width: 700px;
  }

  .about__photos :global(.about__photo--2) {
    top: 800px;
    left: -40px;
    max-width: 1100px;
  }

  .about__text {
    max-width: 1159px;
    padding-top: var(--sp-7);
  }

  .about__intro {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.33;
    color: var(--fg);
    margin: 0 0 var(--sp-10);
  }

  .about__heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-header-1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--fg-muted);
    line-height: 1;
    margin: 0 0 var(--sp-7);
  }

  .about__heading--education {
    margin-top: var(--sp-8);
  }

  /* Tablet — сужаем фото-колонку */
  @media (max-width: 1279px) {
    .about {
      grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
      gap: var(--sp-7);
      padding: var(--sp-10) var(--page-pad) var(--sp-9);
    }

    .about__photos {
      min-height: 1100px;
    }

    .about__photos :global(.about__photo--1) {
      top: 20px;
      left: -60px;
      max-width: 480px;
    }

    .about__photos :global(.about__photo--2) {
      top: 560px;
      left: -20px;
      max-width: 720px;
    }

    .about__intro {
      font-size: 18px;
      margin-bottom: var(--sp-8);
    }

    .about__heading--education {
      margin-top: var(--sp-7);
    }
  }

  /* Wide tablet → narrow tablet (≤1023) — фото-колонка ещё уже */
  @media (max-width: 1023px) {
    .about {
      grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
      gap: var(--sp-6);
    }

    .about__photos {
      min-height: 900px;
    }

    .about__photos :global(.about__photo--1) {
      top: 0;
      left: -40px;
      max-width: 380px;
    }

    .about__photos :global(.about__photo--2) {
      top: 460px;
      left: -10px;
      max-width: 560px;
    }
  }

  /* Mobile — стек */
  @media (max-width: 767px) {
    .about {
      grid-template-columns: 1fr;
      padding: var(--sp-8) var(--page-pad) calc(var(--mob-tabbar) + var(--sp-7));
      gap: 0;
    }

    .about__photos {
      min-height: auto;
      margin-bottom: var(--sp-6);
      margin-left: calc(var(--page-pad) * -1);
      width: calc(100% + var(--page-pad));
    }

    .about__photos :global(.about__photo) {
      position: relative;
      top: auto;
      left: auto;
      max-width: 100%;
      width: 85%;
    }

    .about__photos :global(.about__photo--2) {
      display: none;
    }

    .about__text {
      padding-top: 0;
    }

    .about__intro {
      font-size: 14px;
      line-height: 1.55;
      color: var(--fg);
      margin-bottom: var(--sp-6);
    }

    .about__heading {
      font-size: var(--t-header-1);
      margin-bottom: var(--sp-4);
    }

    .about__heading--education {
      margin-top: var(--sp-4);
    }
  }
</style>
