# Скопируй в .env (`cp .env.example .env`) и поправь под окружение.

# === Прод-деплой (сервер с доменом) ===
# Домен, по которому отдаётся сайт. Caddy сам выпустит и продлит HTTPS (Let's Encrypt).
# Требования: A-запись домена указывает на IP сервера, порты 80 и 443 открыты в фаерволе.
SITE_ADDRESS=proksion.ru
HTTP_PORT=80
HTTPS_PORT=443

# === Локальная проверка контейнера (без домена) ===
# Раскомментируй вместо блока выше — сайт будет на http://localhost:8080, без HTTPS.
# SITE_ADDRESS=:80
# HTTP_PORT=8080
# HTTPS_PORT=8443

# === Локальная разработка (вне Docker) ===
# Vite dev-серверы. Chrome MCP разрешает только порт 5005 (публичный фронт).
FRONT_DEV_PORT=5005
ADMIN_DEV_PORT=5006

# === Бэкенд (Bun + ElysiaJS) ===
# Наружу НЕ публикуется — Caddy ходит на back:3001 по имени сервиса.
BACK_PORT=3001

# === MinIO (S3-совместимое хранилище картинок) ===
# Консоль/порт наружу НЕ публикуются (только внутренняя сеть compose).
# MINIO_ROOT_PASSWORD — минимум 8 символов. На проде задай свои секреты.
MINIO_ROOT_USER=proksion
MINIO_ROOT_PASSWORD=change-me-please
S3_ENDPOINT=http://minio:9000
S3_BUCKET=media
S3_ACCESS_KEY=proksion
S3_SECRET_KEY=change-me-please
